# Copy to .env and fill in. NEVER commit .env (it is git-ignored).
# Keys are injected as environment variables; no secret is ever stored in the repo.

# vast.ai API key (https://cloud.vast.ai/manage-keys/) — used by the orchestration driver.
VAST_API_KEY=

# Hugging Face token — needed if any gated dataset/model is used; Qwen2.5 is public.
HF_TOKEN=

# Optional experiment tracking.
WANDB_API_KEY=

# Hard cost backstop reminder: ALSO set an account-level spending limit in the
# vast.ai console — client-side BudgetGuard is not a substitute for it.
